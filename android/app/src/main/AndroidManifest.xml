<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Manar needs only what the feature set actually uses. No storage,
         camera, microphone, contacts, background location or phone state. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- المنبّهات الدقيقة: SCHEDULE_EXACT_ALARM وحدها، يمنحها المستخدم من شاشة
         «المنبّهات والتذكيرات». لا نعلن USE_EXACT_ALARM: سياسة Google Play تقصرها
         على تطبيقات المنبّه والمؤقّت والتقويم، وإعلانها يعرّض التطبيق للرفض. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- لا نعلن REQUEST_IGNORE_BATTERY_OPTIMIZATIONS (مقيّدة في Google Play):
         نفتح شاشة البطارية في النظام ويختار المستخدم «غير مقيّد» بنفسه. -->
    <!-- «سكينة»: الآلة الرسمية الوحيدة لإسكات الهاتف أثناء الصلاة. يمنحها
         المستخدم من شاشة النظام (الوصول إلى عدم الإزعاج)، ولا تُمنح تلقائياً. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- الإنترنت لخدمتين اختياريتين فقط، كما في سياسة الخصوصية: تسمية المدينة من
         الإحداثيات (OpenStreetMap Nominatim)، وتلاوات القرآن آية بآية (everyayah.com).
         المواقيت والأذان والمصحف والتفسير والأذكار تعمل كلها بلا اتصال. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- الرجوع التنبّئي (المرحلة ٣٢): enableOnBackInvokedCallback=true. كان false
         انسحاباً مؤقتاً يسمح به أندرويد ١٦ ولن يدوم. الرجوع كله يمرّ من
         OnBackPressedDispatcher عبر إضافة @capacitor/app (مستمع backButton في
         src/lib/native-shell.ts)، فلا يعتمد على onBackPressed ولا KEYCODE_BACK. -->
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Plays the full Adhan / Iqama recording with audio focus and
             lock-screen controls, so it is never cut short like a plain
             notification sound. -->
        <service
            android:name=".AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Fired by the exact alarm at prayer time. -->
        <receiver
            android:name=".AdhanAlarmReceiver"
            android:exported="false" />

        <!-- أزرار الإشعارات التي لا تفتح التطبيق: «صلّيت» و«ذكّرني لاحقاً». -->
        <receiver
            android:name=".ManarActionReceiver"
            android:exported="false" />

        <!-- فترات «سكينة»: منبّه للبداية وآخر للنهاية، وزرّ «إيقاف الآن». -->
        <receiver
            android:name=".SakinahReceiver"
            android:exported="false" />

        <!-- Re-arms the saved schedule after a reboot or an app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- لا نعلن LOCKED_BOOT_COMPLETED: المستقبِل directBootAware=false فلا
                     يصله هذا البثّ أصلاً، والجدولة تحتاج التخزين المشفّر بعد فتح القفل. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <!-- بعض الشركات (HTC وشاومي وغيرهما) تُطلق «الإقلاع السريع» بدل BOOT_COMPLETED. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- منح إذن المنبّهات الدقيقة أو سحبه: نعيد الجدولة فوراً بالنوع الصحيح. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ويدجت الشاشة الرئيسية: الصلاة القادمة وآية اليوم. exported=true
             مطلوب ليصله مضيف الويدجت (مشغّل الشاشة الرئيسية). -->
        <receiver
            android:name=".ManarWidget"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/manar_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<!-- Manar mirrors settings, counters, reading position and wird progress into
     Capacitor Preferences (CapacitorStorage.xml); that file is backed up so a
     device change keeps the user's progress, and StorageGate restores it into
     the WebView on first launch.

     Excluded on purpose:
     - ManarSession.xml: legacy sign-in token group from the removed account
       feature. Manar has no account now and purges this file on start; the
       exclusion stays so an old test device never carries it to a new one.
     - WebView Local Storage: everything we need from it already lives in
       CapacitorStorage.xml.
     - manar_adhan_schedule.xml: absolute alarm times from the old device. -->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <exclude domain="sharedpref" path="ManarSession.xml" />
    <exclude domain="sharedpref" path="manar_adhan_schedule.xml" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml: progress travels, the sign-in
     token (ManarSession.xml, WebView Local Storage) and old alarm times do not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ManarSession.xml" />
        <exclude domain="sharedpref" path="manar_adhan_schedule.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="ManarSession.xml" />
        <exclude domain="sharedpref" path="manar_adhan_schedule.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!-- بناء التصحيح وحده: مستقبِل فحصٍ يُشغَّل من adb في اختبار المحاكي
     (.github/workflows/android-runtime-test.yml). لا يدخل حزمة الإصدار أبدًا،
     ولا يستقبل إلا من يملك إذن DUMP (أي adb shell). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".ManarTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.manar.islamic.test.DECODE_ALL" />
                <action android:name="app.manar.islamic.test.SCHEDULE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
